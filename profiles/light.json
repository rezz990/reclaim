{
  "schema": 1,
  "name": "light",
  "description": "Safe tweaks for phones with at most 3 GB of RAM",
  "requires": { "min_sdk": 21, "max_ram_mb": 3072 },
  "steps": [
    {
      "id": "anim-window",
      "kind": "setting",
      "namespace": "global",
      "key": "window_animation_scale",
      "value": "0.5",
      "risk": "safe",
      "min_sdk": 17
    },
    {
      "id": "anim-transition",
      "kind": "setting",
      "namespace": "global",
      "key": "transition_animation_scale",
      "value": "0.5",
      "risk": "safe",
      "min_sdk": 17
    },
    {
      "id": "anim-animator",
      "kind": "setting",
      "namespace": "global",
      "key": "animator_duration_scale",
      "value": "0.5",
      "risk": "safe",
      "min_sdk": 17
    },
    {
      "id": "dexopt",
      "kind": "compile",
      "mode": "speed-profile",
      "scope": "all",
      "risk": "safe",
      "min_sdk": 24
    },
    {
      "id": "idle-maint",
      "kind": "maintenance",
      "risk": "safe",
      "min_sdk": 23
    }
  ]
}
